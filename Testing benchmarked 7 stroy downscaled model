# Input Layer: Two channels (signal and time steps)
input_signal = Input(shape=(2, 12850), name="Input_Signal")  # Shape: (2, 12850)

# Branch 1: Time-Series (Signal Channel) -> LSTM
# Extract signal channel (channel index 0)
time_series = Lambda(lambda x: x[:, 0, :], name="Extract_Signal")(input_signal)
time_series = tf.expand_dims(time_series, axis=-1)  # Add time-series dimension


lstm_branch = LSTM(128, return_sequences=True, name="LSTM1")(time_series)
lstm_branch = BatchNormalization(name="BN_LSTM1")(lstm_branch)
lstm_branch = Dropout(0.3, name="Dropout_LSTM1")(lstm_branch)  # Dropout after the first LSTM layer

lstm_branch = LSTM(64, return_sequences=True, name="LSTM2")(lstm_branch)
lstm_branch = BatchNormalization(name="BN_LSTM2")(lstm_branch)
lstm_branch = Dropout(0.3, name="Dropout_LSTM2")(lstm_branch)  # Dropout after the second LSTM layer

lstm_branch = LSTM(32, return_sequences=True, name="LSTM3")(lstm_branch)
lstm_branch = BatchNormalization(name="BN_LSTM3")(lstm_branch)
lstm_branch = Dropout(0.3, name="Dropout_LSTM3")(lstm_branch)  # Dropout after the third LSTM layer

lstm_branch = LSTM(16, name="LSTM4")(lstm_branch)  # Added one more LSTM layer
lstm_branch = BatchNormalization(name="BN_LSTM4")(lstm_branch)
lstm_branch = Dropout(0.4, name="Dropout_LSTM4")(lstm_branch)  # Higher dropout rate for the final LSTM layer

lstm_branch = Dense(256, activation='relu', name="Dense1_LSTM")(lstm_branch)  # Increased dense units for richer features
lstm_branch = BatchNormalization(name="BN_Dense1-lstm")(lstm_branch)
lstm_branch = Dropout(0.4, name="Dropout_Dense1-LSTM")(lstm_branch)

lstm_branch = Dense(128, activation='relu', name="LSTM_Features")(lstm_branch)  # Original final dense layer
lstm_branch = BatchNormalization(name="BN_Dense2-lstm")(lstm_branch)
lstm_branch = Dropout(0.4, name="Dropout_Dense2-LSTM")(lstm_branch)

# Branch 2: Frequency-Domain Features -> CNN
# Extract signal channel (channel index 0) for frequency domain processing
frequency_input = Lambda(lambda x: x[:, 0, :], name="Extract_Frequency_Signal")(input_signal)

# Transform to Frequency Domain (FFT)
def fft_transform(x):
    freq_data = tf.signal.fft(tf.cast(x, tf.complex64))  # Compute FFT
    return tf.math.abs(freq_data)  # Return magnitude

frequency_features = Lambda(fft_transform, name="FFT_Transform")(frequency_input)
frequency_features = tf.expand_dims(frequency_features, axis=-1)  # Add channel dimension for CNN


cnn_branch = Conv1D(128, kernel_size=5, activation='relu', padding='same', name="CNN_Conv1")(frequency_features)
cnn_branch = BatchNormalization(name="BN_Conv1")(cnn_branch)
cnn_branch = Dropout(0.3, name="Dropout_Conv1")(cnn_branch)  # Dropout after the first convolution

cnn_branch = Conv1D(64, kernel_size=5, activation='relu', padding='same', name="CNN_Conv2")(cnn_branch)
cnn_branch = BatchNormalization(name="BN_Conv2")(cnn_branch)
cnn_branch = Dropout(0.3, name="Dropout_Conv2")(cnn_branch)  # Dropout after the second convolution

cnn_branch = Conv1D(64, kernel_size=3, activation='relu', padding='same', name="CNN_Conv3")(cnn_branch)
cnn_branch = BatchNormalization(name="BN_Conv3")(cnn_branch)

cnn_branch = Conv1D(32, kernel_size=3, activation='relu', padding='same', name="CNN_Conv4")(cnn_branch)
cnn_branch = BatchNormalization(name="BN_Conv4")(cnn_branch)
cnn_branch = Dropout(0.3, name="Dropout_Conv4")(cnn_branch)  # Dropout after the fourth convolution

cnn_branch = Flatten(name="Flatten_CNN")(cnn_branch)
cnn_branch = Dense(256, activation='relu', name="Dense1_CNN")(cnn_branch)
cnn_branch = BatchNormalization(name="BN_Dense1")(cnn_branch)
cnn_branch = Dropout(0.4, name="Dropout_Dense1")(cnn_branch)  # Dropout after the dense layer

cnn_branch = Dense(128, activation='relu', name="CNN_Features")(cnn_branch)
cnn_branch = BatchNormalization(name="BN_Dense2")(cnn_branch)
cnn_branch = Dropout(0.4, name="Dropout_Dense2")(cnn_branch)  # Dropout after the final dense layer

# Merge Branches
merged = Concatenate(name="Merged_Features")([lstm_branch, cnn_branch])
merged = Dense(128, activation='relu')(merged)
merged = Dropout(0.5)(merged)

# Output Layer
output = Dense(3, activation='softmax', name="Output")(merged)  # Assuming 5 classes for classification

# Define the Model
model = Model(inputs=input_signal, outputs=output)
model.summary()
Adam = Adam(learning_rate=0.01)
# Compile the Model
