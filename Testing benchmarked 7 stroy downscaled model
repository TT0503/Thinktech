from tensorflow.keras.layers import Input, Dense, LSTM
from tensorflow.keras.models import Model
import numpy as np
import tensorflow as tf
from tensorflow.keras.optimizers import Adam


# Actor Network (Policy Network)
def create_actor(state_shape, action_space):
    state_input = Input(shape=state_shape)
    x = LSTM(128, activation='relu')(state_input)
    x = Dense(64, activation='relu')(x)
    action_output = Dense(action_space, activation='softmax')(x)
    return Model(state_input, action_output)


# Critic Network (Value Network)
def create_critic(state_shape):
    state_input = Input(shape=state_shape)
    x = LSTM(128, activation='relu')(state_input)
    x = Dense(64, activation='relu')(x)
    value_output = Dense(1)(x)  # State value prediction
    return Model(state_input, value_output)


# Example of adaptive labeling based on critic evaluation
def adapt_label(critic_value, reward, threshold=0.5):
    """
    Adjust the label based on critic's value and the reward. If the critic is uncertain,
    adapt the reward (label) more strongly to improve learning stability.
    """
    if abs(critic_value - reward) > threshold:
        # Example correction: If large discrepancy, adjust reward closer to critic's value
        return critic_value
    return reward


# Training loop
state = np.random.random((1, 10))  # Random state
reward = 1  # Example reward
action_taken = np.array([1])  # Example action taken

actor = create_actor(state_shape=(10,), action_space=4)
critic = create_critic(state_shape=(10,))

actor_optimizer = Adam(learning_rate=0.001)
critic_optimizer = Adam(learning_rate=0.001)

with tf.GradientTape() as tape:
    # Forward pass through actor and critic
    action_probabilities = actor(state)
    critic_value = critic(state)

    # Apply adaptive label correction (adjusting reward dynamically)
    corrected_reward = adapt_label(critic_value, reward)

    # Calculate actor loss (policy gradient)
    log_prob = tf.math.log(action_probabilities[0, action_taken])
    actor_loss = -log_prob * corrected_reward

    # Calculate critic loss (mean squared error of value prediction)
    critic_loss = (corrected_reward - critic_value) ** 2

    total_loss = actor_loss + critic_loss

# Apply gradients for optimization
gradients = tape.gradient(total_loss, actor.trainable_variables + critic.trainable_variables)
actor_optimizer.apply_gradients(zip(gradients[:len(actor.trainable_variables)], actor.trainable_variables))
critic_optimizer.apply_gradients(zip(gradients[len(actor.trainable_variables):], critic.trainable_variables))
